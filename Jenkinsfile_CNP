#!groovy

@Library("Infrastructure@2.8.0")

import uk.gov.hmcts.contino.AppPipelineDsl

def type = "java"
def product = "camunda"
def component = "bpm"


def secrets = [
    secret('camunda-enterprise-user', 'CAMUNDA_NEXUS_USER'),
    secret('camunda-enterprise-password', 'CAMUNDA_NEXUS_PASSWORD'),
]

def vaultSecrets = [
    'wa-${env}': [
        secret('generic-docker-pact-broker-password', 'GENERIC_DOCKER_PACT_BROKER_YAML_PASS'),
    ],
    's2s-${env}': [
        secret('microservicekey-camunda-bpm', 'S2S_SECRET_CAMUNDA_BPM'),
    ]
]



static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}


withPipeline(type, product, component) {

    loadVaultSecrets(vaultSecrets)

    before('build') {
        withAzureKeyvault(
            azureKeyVaultSecrets: secrets,
            keyVaultURLOverride: 'https://rpe-prod.vault.azure.net'
        ) {
            env.CAMUNDA_NEXUS_USER = "${CAMUNDA_NEXUS_USER}"
            env.CAMUNDA_NEXUS_PASSWORD = "${CAMUNDA_NEXUS_PASSWORD}"
            echo 'Camunda EE credentials loaded for Gradle (CAMUNDA_NEXUS_USER / CAMUNDA_NEXUS_PASSWORD)'
        }
    }

    env.S2S_URL = "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal"
    env.TASK_MANAGEMENT_API_URL = "http://wa-task-management-api-aat.service.core-compute-aat.internal"
    env.PACT_BROKER_FULL_URL = "https://pact-broker.platform.hmcts.net"

    afterSuccess('pact-provider-verification') {
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'build/reports/tests/**/*'
    }

    onMaster() {
        enablePactAs([AppPipelineDsl.PactRoles.CONSUMER])
    }

    onPR() {
        enablePactAs([AppPipelineDsl.PactRoles.CONSUMER])
    }

    enableDbMigration("camunda")
    def branchesToSync = ['demo', 'perftest', 'ithc']
    syncBranchesWithMaster(branchesToSync)
    alwaysTerraformPlanOnPR()
}
